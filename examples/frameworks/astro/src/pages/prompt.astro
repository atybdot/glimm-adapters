---
import { agentPrompt, demos } from "@glimm-examples/shared/demo-data";
import DemoPage from "../components/DemoPage.astro";
import Layout from "../layouts/Layout.astro";

const demo = demos.astro;
const prompt = agentPrompt(demo);
---

<Layout title={`glimm-adapters × ${demo.name} · Prompt`}>
  <DemoPage page="prompt">
    <figure class="code code--prose">
      <figcaption class="code-head">
        <span>agent prompt</span>
        <button type="button" class="copy" data-copy aria-label="Copy the prompt">
          <svg
            class="copy__copy"
            viewBox="0 0 16 16"
            width="15"
            height="15"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="6" y="6" width="8" height="8" rx="1.5"></rect>
            <path d="M10 6V3.5A1.5 1.5 0 0 0 8.5 2h-5A1.5 1.5 0 0 0 2 3.5v5A1.5 1.5 0 0 0 3.5 10H6"></path>
          </svg>
          <svg
            class="copy__check"
            viewBox="0 0 16 16"
            width="15"
            height="15"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m3 8.5 3.2 3L13 4.5"></path>
          </svg>
        </button>
      </figcaption>
      <pre><code>{prompt}</code></pre>
    </figure>
  </DemoPage>
</Layout>
