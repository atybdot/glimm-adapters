---
interface Props {
  page: "home" | "about";
}

const { page } = Astro.props;
// Astro trims the trailing slash from `base`, so add it back for the links.
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<div class="page" data-page={page}>
  <header class="topbar">
    <a class="brand" href={base}>
      <span class="mark"></span> glimm <span>/ Astro</span>
    </a>
    <nav>
      <a href={base} aria-current={page === "home" ? "page" : undefined}>Home</a>
      <a href={`${base}about`} aria-current={page === "about" ? "page" : undefined}>About</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <slot />
    </section>
  </main>

  <footer class="footer">
    <span>glimm-adapters / astro</span>
    <span>setupGlimmAstro · mode: reveal</span>
  </footer>
</div>
