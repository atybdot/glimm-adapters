---
import { ClientRouter } from "astro:transitions";
import "@glimm-examples/shared/demo.css";

interface Props {
  title?: string;
}

const { title = "glimm-adapters × Astro" } = Astro.props;
---

<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:," />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <!-- transition:persist keeps this node across Astro's swaps. The adapter
         re-hosts it and owns the sweep. -->
    <canvas id="glimm" transition:persist="glimm-canvas" aria-hidden="true"></canvas>

    <slot />

    <script>
      import { navigate } from "astro:transitions/client";
      import { accentChain } from "glimm-adapters";
      import { setupGlimmAstro } from "glimm-adapters/astro";
      import { demos, SWEEP_MS } from "@glimm-examples/shared/demo-data";
      import { flashCopy } from "@glimm-examples/shared/copy";
      import { initPicker } from "@glimm-examples/shared/picker";

      const canvas = document.querySelector("#glimm");
      if (canvas instanceof HTMLCanvasElement) {
        setupGlimmAstro({
          canvas,
          navigate,
          mode: "reveal",
          defaults: {
            sweepMs: SWEEP_MS,
            palette: accentChain(demos.astro.palette),
          },
        });
      }

      // Astro re-runs this script after a swap, but the document listeners must
      // only be bound once.
      const view = window as Window & { __glimmDemoWired?: boolean };
      if (!view.__glimmDemoWired) {
        view.__glimmDemoWired = true;
        initPicker();

        document.addEventListener("click", (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          const tab = target.closest("[data-tab]");
          if (tab instanceof HTMLButtonElement) {
            const panel = tab.closest(".panel");
            if (!panel) return;

            const id = tab.dataset.tab;
            for (const button of panel.querySelectorAll("[data-tab]")) {
              button.setAttribute("aria-pressed", String(button === tab));
            }
            for (const sheet of panel.querySelectorAll("[data-panel]")) {
              if (sheet instanceof HTMLElement) sheet.hidden = sheet.dataset.panel !== id;
            }
            return;
          }

          const button = target.closest("[data-copy]");
          if (!(button instanceof HTMLButtonElement)) return;

          const text = button
            .closest(".panel")
            ?.querySelector("[data-panel]:not([hidden]) code")?.textContent;
          if (text) void flashCopy(button, text);
        });
      }
    </script>
  </body>
</html>
