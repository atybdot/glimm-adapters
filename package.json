{
  "name": "glimm-adapters-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "glimm-adapters: router adapters for glimm sweep transitions, plus demo apps.",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:lib": "turbo run build --filter=glimm-adapters",
    "build:web": "turbo run build --filter=web",
    "build:examples": "pnpm --filter \"@glimm-examples/*\" --filter \"!@glimm-examples/shared\" build",
    "stage:examples": "node scripts/stage-examples.mjs",
    "build:web:full": "pnpm build:lib && pnpm build:examples && pnpm stage:examples && pnpm --filter web build",
    "deploy:web:full": "pnpm build:lib && pnpm build:examples && pnpm stage:examples && pnpm --filter web deploy",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev:app --filter=web",
    "dev:examples": "pnpm --parallel --filter \"@glimm-examples/*\" --filter \"!@glimm-examples/shared\" dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "clean": "turbo run clean",
    "prepare": "lefthook install",
    "publish:release": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "portless": "^0.15.9",
    "turbo": "^2.11.10"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@12.15.0"
}
